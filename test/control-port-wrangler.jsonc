{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "toktok",
  "main": "control-port-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "SIGNUP_POLICY_JSON": "{\"mode\":\"restricted\",\"allowed_emails\":[\"allowed@fixture.example\",\"second@fixture.example\"]}",
    "EMAIL_LIMITS_JSON": "{\"email_hour\":2,\"email_day\":3,\"cooldown_seconds\":120,\"ip_hour\":30,\"ip_day\":100,\"month\":10000}",
    "ADMIN_BOOTSTRAP_EMAIL": "admin@fixture.example"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "IDENTITIES",
        "class_name": "ControlPlane"
      },
      {
        "name": "DISABLED_IDENTITIES",
        "class_name": "UnconfiguredRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ControlPlane"
      ]
    },
    {
      "tag": "test-unconfigured",
      "new_sqlite_classes": [
        "UnconfiguredRegistry"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "IP_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CREATOR_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
