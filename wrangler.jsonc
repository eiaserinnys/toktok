{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toktok", "main": "src/index.ts", "compatibility_date": "2026-10-01", "compatibility_flags": ["enable_request_signal"],
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":true, "html_handling":"none", "not_found_handling":"none"},
  "workers_dev": false, "preview_urls": false,
  "observability": {"enabled": false, "logs": {"enabled": false, "invocation_logs": false}, "traces": {"enabled": false}},
  "routes": [{"pattern": "toktok.eiaserinnys.me", "custom_domain": true}],
  "vars": {"PUBLIC_ORIGIN": "https://toktok.eiaserinnys.me", "CREATOR_CREDENTIALS_JSON": "[]"},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "Room"}, {"name": "PUBLIC_ROOMS", "class_name": "PublicRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Room"]}, {"tag":"public-v1", "new_sqlite_classes":["PublicRoom"]}],
  "ratelimits": [
    {"name": "IP_RATE_LIMIT", "namespace_id": "1001", "simple": {"limit": 120, "period": 60}},
    {"name": "CREATOR_RATE_LIMIT", "namespace_id": "1002", "simple": {"limit": 5, "period": 60}}
  ]
}
