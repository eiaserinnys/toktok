      "post": {
        "operationId": "createRoom",
        "summary": "Approved creator only",
        "description": "Empty/missing/malformed creator registry fails closed with 503. Returns separate owner token, never embedded in shared URLs.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_REQUIRED / INVALID_CREDENTIAL",
