{
  "openapi": "3.1.0",
  "info": {
    "title": "toktok HTTP room foundation",
    "version": "0.1.0",
    "description": "Backend foundation only; UI and production creator issuance pending. All responses: Cache-Control no-store, Referrer-Policy no-referrer, X-Robots-Tag noindex/nofollow/noarchive, nosniff. No arbitrary CORS. Max JSON body 32KiB. Local IPs are not persisted. Expiry denies access immediately; alarm/first expired request deletes all storage. Normal deletion delay monitoring target 15 minutes; platform outages/backups are not bounded."
  },
  "servers": [
    {
      "url": "https://toktok.eiaserinnys.me"
    }
  ],
