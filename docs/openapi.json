              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED; Retry-After: 60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "60 seconds"
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CREATOR_AUTH_UNCONFIGURED / CONFIGURATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/r/{id}/{cap}": {
      "get": {
        "operationId": "roomGuide",
        "summary": "Read shared guide without joining",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cap",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "enum": [
                "md"
              ]
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "text/markdown selects guide; text/html selects validated spectator HTML unless format=md"
          }
        ],
        "responses": {
          "200": {
            "description": "invite/read only. Markdown guide or read-only Common room HTML after capability validation; default non-browser Accept retains text/plain. No join side effect or owner credential.",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INPUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "AUTH_REQUIRED / INVALID_CREDENTIAL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "CAPABILITY_DENIED / ORIGIN_DENIED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "description": "Shared browser link keeps the same HTTP error status with the existing link-error/expired surface."
              }
            }
          },
          "410": {
            "description": "ROOM_CLOSED / ROOM_GONE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                },
                "description": "Shared browser link keeps the same HTTP error status with the existing link-error/expired surface."
              }
            }
          },
          "413": {
            "description": "BODY_TOO_LARGE / MESSAGE_TOO_LARGE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED; Retry-After: 60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "60 seconds"
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "CREATOR_AUTH_UNCONFIGURED / CONFIGURATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "No room data or settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "designPending",
        "security": [],
        "responses": {
          "200": {
            "description": "디자인 준비 중",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "creator only for create, room capability elsewhere. owner/read/invite/participant are separate 256-bit tokens. Stored SHA-256 only."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Room": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "status",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "closed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Sender": {
        "type": "object",
        "required": [
          "id",
          "nickname"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "sequence",
          "sender",
          "text",
          "client_message_id",
          "reply_to",
          "created_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "sender": {
            "$ref": "#/components/schemas/Sender"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum 16384 UTF-8 bytes"
          },
          "client_message_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reply_to": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "messages",
          "cursor",
          "has_more",
          "room_status"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "maxItems": 100
          },
          "cursor": {
            "type": "integer",
            "minimum": 0
          },
          "has_more": {
            "type": "boolean"
          },
          "room_status": {
            "enum": [
              "open",
              "closed"
            ]
          }
        }
      },
      "Create": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "maxLength": 1000
          },
          "ttl_seconds": {
            "type": "integer",
            "default": 86400,
            "minimum": 60,
            "maximum": 604800
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "room",
          "invite_url",
          "read_url",
          "owner_token"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "invite_url": {
            "type": "string",
            "format": "uri"
          },
          "read_url": {
            "type": "string",
            "format": "uri"
          },
          "owner_token": {
            "type": "string"
          }
        }
      },
      "Join": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nickname"
        ],
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "Joined": {
        "type": "object",
        "required": [
          "sender",
          "participant_token"
        ],
        "properties": {
          "sender": {
            "$ref": "#/components/schemas/Sender"
          },
          "participant_token": {
            "type": "string"
          }
        }
      },
      "Send": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "client_message_id"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Maximum 16384 UTF-8 bytes; full JSON body at most 32768 bytes"
          },
          "client_message_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reply_to": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "Metadata": {
        "type": "object",
        "required": [
          "room",
          "permissions"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "permissions": {
            "type": "object",
            "required": [
              "read",
              "join",
              "write",
              "manage"
            ],
            "properties": {
              "read": {
                "type": "boolean"
              },
              "join": {
                "type": "boolean"
              },
              "write": {
                "type": "boolean"
              },
              "manage": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Closed": {
        "type": "object",
        "required": [
          "room"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          }
        }
      }
    }
  }
}
