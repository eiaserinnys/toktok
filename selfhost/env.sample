TOKTOK_BACKEND=sqlite
PUBLIC_ORIGIN=https://toktok.example.invalid
PORT=8080
TOKTOK_SQLITE_FILE=/data/toktok.sqlite
# PostgreSQL is selected instead of SQLite, never in addition to it.
TOKTOK_WITH_POSTGRES=false
TOKTOK_PG_SCHEMA=toktok
TOKTOK_DSN_FILE=/run/secrets/toktok-pg-dsn
# Mount a user-provided 0600 secret file with a local Compose override.
# No DSN/password/email/OTP is included in this sample.
# Set these only in an untracked private environment; never commit real addresses.
ADMIN_BOOTSTRAP_EMAIL=
TOKTOK_SMTP_CONFIG_FILE=
TOKTOK_TRUSTED_PROXY_CIDRS=
# Optional SMTP JSON is a user-supplied 0600 file mounted read-only.
# No SMTP connection or verification email is made at startup.
