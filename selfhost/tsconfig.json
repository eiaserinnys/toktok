{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "pg": [
        "./node_modules/@types/pg/index.d.ts"
      ],
      "nodemailer": [
        "./node_modules/@types/nodemailer/index.d.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "../src/runtime/**/*.ts",
    "../src/storage/**/*.ts",
    "../src/selfhost/**/*.ts",
    "../src/public-core.ts",
    "../src/public-contracts.ts",
    "../src/public-http.ts",
    "../test/selfhost*.test.ts",
    "../test/private-verification-http.test.ts",
    "../src/private-core.ts",
    "../src/private-contracts.ts",
    "../test/integration-node-http.test.ts"
  ],
  "exclude": [
    "../test/*cloudflare*.test.ts"
  ]
}
