#!/usr/bin/env bash
set -euo pipefail
target=${1:?Usage: prepare-postgres-secret PRIVATE_FILE}
if [[ -e "$target" || -L "$target" ]]; then
  printf '%s\n' 'Refusing to overwrite an existing path.' >&2
  exit 1
fi
umask 077
mkdir -p -- "$(dirname -- "$target")"
trap 'unset toktok_dsn_input' EXIT
read -r -s -p 'PostgreSQL DSN (hidden): ' toktok_dsn_input </dev/tty
printf '\n' >/dev/tty
case "$toktok_dsn_input" in postgres://*|postgresql://*) ;; *) printf '%s\n' 'Expected a PostgreSQL connection URI.' >&2; exit 1 ;; esac
set -o noclobber
printf '%s' "$toktok_dsn_input" >"$target"
unset toktok_dsn_input
printf '%s\n' 'Private file created. No database connection was made.'
